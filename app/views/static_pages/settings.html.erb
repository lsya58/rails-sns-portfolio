<div class="container">
  <h1>設定</h1>

  <div class="card" style="margin-bottom: 20px;">
    <h3>プロフィール設定</h3>
    <%= link_to "プロフィールを編集", edit_user_path(@user), class: "btn btn-primary" %>
  </div>

  <div class="card" style="margin-bottom: 20px;">
    <h3>パスワード変更</h3>
    <%= form_with(model: @user, url: user_path(@user), method: :patch) do |f| %>
      <%= render 'shared/error_messages', object: @user %>
      
      <%= f.label :current_password, "現在のパスワード" %>
      <%= f.password_field :current_password, class: 'form-control' %>
      
      <%= f.label :password, "新しいパスワード" %>
      <%= f.password_field :password, class: 'form-control' %>
      
      <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
      <%= f.password_field :password_confirmation, class: 'form-control' %>
      
      <%= f.submit "パスワードを変更", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="card" style="border-color: #f4212e;">
    <h3 style="color: #f4212e;">アカウント削除</h3>
    <p>この操作は取り消せません。全てのデータが削除されます。</p>
    <%= button_to "アカウントを削除", user_path(@user), 
                  method: :delete, 
                  data: { turbo_confirm: "本当に削除しますか？全てのデータが失われます。" },
                  class: "btn",
                  style: "background-color: #f4212e; color: white;" %>
  </div>
</div>