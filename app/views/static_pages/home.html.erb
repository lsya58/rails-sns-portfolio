<% if logged_in? %>
  <div class="container">
    <div class="post-form">
      <%= form_with(model: @micropost) do |f| %>
        <%= render 'shared/error_messages', object: @micropost %>
        <%= f.text_area :content, placeholder: "いまなにしてる？", rows: 3 %>
        <%= f.file_field :image, accept: 'image/*' %>
        <%= f.submit "投稿", class: "btn btn-primary" %>
      <% end %>
    </div>

    <h3>タイムライン</h3>
    <div class="feed">
      <%= render @feed_items %>
      <%= will_paginate @feed_items %>
    </div>
  </div>
<% else %>
  <div class="container">
    <div class="card">
      <h1>ようこそ MyTwitterClone へ</h1>
      <p>SNSアプリケーションです</p>
      <%= link_to "新規登録", signup_path, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>