<h1>
  <% other_user = @room.users.where.not(id: current_user.id).first %>
  <%= other_user.name %> とのメッセージ
</h1>

<div id="messages" data-room-id="<%= @room.id %>">
  <%= render @messages %>
</div>

<%= form_with(model: [@room, @message], id: "message-form") do |f| %>
  <%= f.text_area :content, placeholder: "メッセージを入力...", rows: 3, id: "message-content" %>
  <%= f.submit "送信", class: "btn btn-primary" %>
<% end %>

<%= link_to "戻る", rooms_path %>