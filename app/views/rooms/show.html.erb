<h1>
  <% other_user = @room.users.where.not(id: current_user.id).first %>
  <%= other_user.name %> とのメッセージ
</h1>

<div id="messages">
  <% @messages.each do |message| %>
    <div>
      <strong><%= message.user.name %>:</strong>
      <%= message.content %>
      <small><%= time_ago_in_words(message.created_at) %>前</small>
    </div>
  <% end %>
</div>

<%= form_with(model: [@room, @message]) do |f| %>
  <%= f.text_area :content, placeholder: "メッセージを入力...", rows: 3 %>
  <%= hidden_field_tag :room_id, @room.id %>
  <%= f.submit "送信", class: "btn btn-primary" %>
<% end %>

<%= link_to "戻る", rooms_path %>